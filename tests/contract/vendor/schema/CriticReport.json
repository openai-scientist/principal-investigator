{
  "$defs": {
    "CriticPoint": {
      "properties": {
        "lens": {
          "enum": [
            "charter",
            "risk",
            "directive",
            "integrity"
          ],
          "title": "Lens",
          "type": "string"
        },
        "locator": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Locator"
        },
        "point": {
          "title": "Point",
          "type": "string"
        },
        "point_id": {
          "title": "Point Id",
          "type": "string"
        },
        "ref": {
          "title": "Ref",
          "type": "string"
        },
        "severity": {
          "enum": [
            "serious",
            "minor"
          ],
          "title": "Severity",
          "type": "string"
        },
        "suggestion": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Suggestion"
        }
      },
      "required": [
        "point_id",
        "severity",
        "lens",
        "ref",
        "point"
      ],
      "title": "CriticPoint",
      "type": "object"
    },
    "ObligationCheck": {
      "properties": {
        "locator": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Locator"
        },
        "note": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Note"
        },
        "obligation_id": {
          "title": "Obligation Id",
          "type": "string"
        },
        "status": {
          "enum": [
            "controlled",
            "unresolved"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "obligation_id",
        "status"
      ],
      "title": "ObligationCheck",
      "type": "object"
    }
  },
  "$id": "urn:research-contract:1.3.0:CriticReport",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "The independent stage-end review. The PI answers its serious points.",
  "properties": {
    "model": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Model"
    },
    "model_shared_with": {
      "anyOf": [
        {
          "const": "lead",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Model Shared With"
    },
    "obligations": {
      "items": {
        "$ref": "#/$defs/ObligationCheck"
      },
      "title": "Obligations",
      "type": "array"
    },
    "points": {
      "items": {
        "$ref": "#/$defs/CriticPoint"
      },
      "title": "Points",
      "type": "array"
    },
    "summary": {
      "title": "Summary",
      "type": "string"
    },
    "verdict": {
      "enum": [
        "sound",
        "concerns",
        "serious"
      ],
      "title": "Verdict",
      "type": "string"
    }
  },
  "required": [
    "verdict",
    "summary"
  ],
  "title": "CriticReport",
  "type": "object"
}
